# GitHub PAT with repo read/write access (Settings → Developer settings → Tokens)
GITHUB_TOKEN=your_github_token_here

# CometAPI key (cometapi.com): single key for Claude and other models
COMET_API_KEY=your_comet_api_key_here

# OpenAI-compatible LLM endpoint and model (defaults shown, override if needed)
# COMET_BASE_URL=https://api.cometapi.com/v1
# LLM_MODEL=claude-haiku-4-5-20251001

# Target repository (defaults shown — override if needed)
# REPO_OWNER=kulcsarrudolf
# REPO_NAME=samsung-device-helper
