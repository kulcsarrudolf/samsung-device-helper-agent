{
  "name": "samsung-device-helper-agent",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.17.1",
  "repository": "git@github.com:kulcsarrudolf/samsung-device-helper-agent.git",
  "author": "kulcsarrudolf <kulcsarrudolf@gmail.com>",
  "license": "MIT",
  "scripts": {
    "postinstall": "npx playwright install chromium && (lefthook install || true)",
    "sync": "tsx src/sync/index.ts",
    "init:env": "tsx scripts/init-env.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "yarn typecheck && yarn lint && yarn format:check && yarn test"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "@octokit/rest": "^22.0.1",
    "@playwright/mcp": "^0.0.78",
    "openai": "^6.48.0",
    "prettier": "^3.9.6",
    "zod": "^4.4.3"
  }
}
