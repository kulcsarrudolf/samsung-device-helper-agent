{
  "name": "samsung-device-helper-agent",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.17.1",
  "repository": "git@github.com:kulcsarrudolf/samsung-device-helper-agent.git",
  "author": "kulcsarrudolf <kulcsarrudolf@gmail.com>",
  "license": "MIT",
  "scripts": {
    "postinstall": "npx playwright install chromium",
    "sync": "tsx src/sync/index.ts",
    "init:env": "tsx scripts/init-env.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "yarn typecheck && yarn lint && yarn format:check"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@playwright/mcp": "^0.0.78",
    "dotenv": "^17.3.1",
    "openai": "^6.48.0"
  }
}
